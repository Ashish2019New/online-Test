      "source": [
        "# Initialize task lists\n",
        "checklist = []\n",
        "completed_tasks = []\n",
        "incomplete_tasks = []\n",
        "\n",
        "# Populate checklist with example tasks\n",
        "checklist.append(\"Grocery shopping\")\n",
        "checklist.append(\"Finish report\")\n",
        "checklist.append(\"Go for a run\")\n",
        "checklist.append(\"Read a book\")\n",
        "\n",
        "print(\"Your daily checklist:\")\n",
        "for task in checklist:\n",
        "    print(f\"- {task}\")\n",
        "\n",
        "# Review tasks and organize them\n",
        "print(\"\\nReview your tasks. Mark completed tasks with 'c' and incomplete tasks with 'i':\")\n",
        "for task in checklist:\n",
        "    while True:\n",
        "        response = input(f\"Did you complete '{task}'? (c/i): \").lower()\n",
        "        if response == 'c':\n",
        "            completed_tasks.append(task)\n",
        "            break\n",
        "        elif response == 'i':\n",
        "            incomplete_tasks.append(task)\n",
        "            break\n",
        "        else:\n",
        "            print(\"Invalid input. Please enter 'c' for completed or 'i' for incomplete.\")\n",
        "\n",
        "# Display results\n",
        "print(\"\\n--- Daily Task Summary ---\")\n",
        "print(\"\\nCompleted Tasks:\")\n",
        "if completed_tasks:\n",
        "    for task in completed_tasks:\n",
        "        print(f\"- {task}\")\n",
        "else:\n",
        "    print(\"No tasks completed today.\")\n",
        "\n",
        "print(\"\\nIncomplete Tasks:\")\n",
        "if incomplete_tasks:\n",
        "    for task in incomplete_tasks:\n",
        "        print(f\"- {task}\")\n",
        "else:\n",
        "    print(\"All tasks completed today!\")"
      ],
